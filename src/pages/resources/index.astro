---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  { href: '/resources/essential-eight-medical-practices', label: 'Security baseline', title: 'Essential Eight for Medical Practices', description: 'Translate the ACSC baseline into a practical improvement plan for clinics, allied health and specialist practices.', time: '10 min' },
  { href: '/resources/healthcare-data-breach-response', label: 'Incident response', title: 'Healthcare Data Breach Response Checklist', description: 'A calm, evidence-preserving sequence for the first hour, first day and regulatory assessment.', time: '9 min' },
  { href: '/resources/healthcare-ai-governance', label: 'Clinical AI', title: 'Healthcare AI Governance Checklist', description: 'Questions for evaluating safety, privacy, security and oversight before a clinical AI tool goes live.', time: '8 min' },
];
---

<BaseLayout title="Australian Healthcare Cybersecurity Resources" description="Practical Australian guides for healthcare cybersecurity, data breach response, Essential Eight implementation and clinical AI governance.">
  <div class="resources container">
    <header>
      <p class="eyebrow">Practical library · Australia</p>
      <h1>Turn intelligence into safer care.</h1>
      <p>Plain-English, source-backed resources for practice managers, digital health teams, clinicians and security leaders.</p>
    </header>
    <section class="guide-grid" aria-label="Healthcare cybersecurity guides">
      {guides.map((guide, index) => (
        <a class="guide-card" href={guide.href}>
          <span class="number">0{index + 1}</span>
          <span class="label">{guide.label}</span>
          <h2>{guide.title}</h2>
          <p>{guide.description}</p>
          <span class="open">Read guide · {guide.time} →</span>
        </a>
      ))}
    </section>
    <section class="principles">
      <div><strong>Australian context</strong><p>Built around current Australian Government and healthcare-sector guidance.</p></div>
      <div><strong>Operational language</strong><p>Designed to support a conversation with your IT, privacy and clinical-governance teams.</p></div>
      <div><strong>Reviewed sources</strong><p>Every guide links back to the primary authority so you can verify the latest position.</p></div>
    </section>
  </div>
</BaseLayout>

<style>
.resources { padding: 4.5rem 1.25rem; }
header { max-width: 820px; }
.eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .15em; }
h1 { margin-top: .7rem; font-size: clamp(2.7rem, 7vw, 5.4rem); line-height: .98; letter-spacing: -.045em; text-wrap: balance; }
header > p:last-child { max-width: 62ch; margin-top: 1.4rem; color: var(--subtle); font-size: 1.08rem; line-height: 1.65; }
.guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3.5rem; }
.guide-card { position: relative; display: flex; flex-direction: column; min-height: 360px; padding: 1.5rem; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; transition: transform .18s, border-color .18s; }
.guide-card:hover { transform: translateY(-4px); border-color: var(--accent); color: var(--text); }
.number { position: absolute; right: 1.2rem; top: 1rem; color: var(--border); font: 700 3.8rem/1 var(--font-display); }
.label { position: relative; color: var(--accent); font: .63rem var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }
h2 { position: relative; margin-top: 4.5rem; font-size: 1.55rem; line-height: 1.18; }
.guide-card p { margin-top: .85rem; color: var(--muted); font-size: .88rem; line-height: 1.65; }
.open { margin-top: auto; padding-top: 1rem; color: var(--accent); font-size: .76rem; font-weight: 700; }
.principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); }
.principles strong { color: var(--text); }
.principles p { margin-top: .4rem; color: var(--muted); font-size: .83rem; line-height: 1.55; }
@media (max-width: 820px) { .guide-grid, .principles { grid-template-columns: 1fr; } .guide-card { min-height: 300px; } }
</style>
