---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import SeverityBadge from '../components/SeverityBadge.astro';
import AdBanner from '../components/AdBanner.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/* OAIC NDB tracker drives the "vitals" panel — read straight from the tracker post */
const tracker = allPosts.find(p => p.id.includes('healthcare-data-breaches-tracker'));
const tb = tracker?.body ?? '';
const figure    = tb.match(/\*\*(\d[\d,]*)\s+notifiable data breaches\*\*/)?.[1] ?? null;
const period    = tb.match(/notifiable data breaches\*\*\s+in\s+([^,]+),/)?.[1] ?? null;
const malicious = tb.match(/Malicious or criminal attack:\*\*\s*(\d+)/)?.[1] ?? null;
const humanErr  = tb.match(/Human error:\*\*\s*(\d+)/)?.[1] ?? null;
const systemF   = tb.match(/System fault:\*\*\s*(\d+)/)?.[1] ?? null;
const peak = Math.max(Number(malicious ?? 0), Number(humanErr ?? 0), Number(systemF ?? 0)) || 1;
const bars = [
  { label: 'Malicious or criminal attack', value: malicious, tone: 'var(--crit)' },
  { label: 'Human error',                  value: humanErr,  tone: 'var(--high)' },
  { label: 'System fault',                 value: systemF,   tone: 'var(--med)'  },
].filter(b => b.value);

const lead = allPosts.find(p => p.id !== tracker?.id) ?? allPosts[0];
const latest = allPosts.filter(p => p.id !== lead?.id && p.id !== tracker?.id).slice(0, 6);

const categories = [
  { slug: 'attacks-breaches',   label: 'Attacks & Breaches', blurb: 'Ransomware, intrusions, notifiable breaches and settlements affecting health providers.' },
  { slug: 'ai-healthcare',      label: 'AI in Healthcare',   blurb: 'Clinical AI, model risk, and the hard questions about patient data in machine systems.' },
  { slug: 'health-it-security', label: 'Health IT',          blurb: 'EHR platforms, integrations and the operational security of clinical infrastructure.' },
];
const counts: Record<string, number> = Object.fromEntries(
  categories.map(c => [c.slug, allPosts.filter(p => p.data.category === c.slug).length])
);

const leadDate = lead?.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
const deskDate = new Date().toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' });
---

<BaseLayout title="Australian Healthcare Cyber Security News & Breach Intelligence">

  <section class="container masthead">
    <div class="masthead-copy">
      <p class="edition">Australian health security desk <span>{deskDate}</span></p>
      <h1>Cyber intelligence for a health system under pressure.</h1>
      <p class="masthead-intro">Independent reporting on the breaches, privacy decisions and emerging technology risks shaping Australian healthcare.</p>
    </div>
    <div class="masthead-note">
      <span class="signal"><i></i> Intelligence feed active</span>
      <strong>{allPosts.length}</strong>
      <small>reports in the archive</small>
      <a href="/blog">Explore all intelligence →</a>
    </div>
  </section>

  <!-- ── Hero: sector vitals + lead story ─────────────────────────── -->
  <section class="container hero">
    <div class="eyebrow">Briefing room — OAIC sector data &amp; lead intelligence</div>

    <div class="hero-grid">
      <aside class="vitals">
        <span class="panel-label">Sector signal 01</span>
        <h2>Health remains Australia&rsquo;s most-breached sector</h2>

        {figure ? (
          <div>
            <div class="figure">{figure}<span>breaches</span></div>
            {period && <div class="period">Health service providers · {period}</div>}
          </div>
        ) : (
          <p class="period">Latest OAIC figures are being updated.</p>
        )}

        {bars.length > 0 && (
          <div class="bars">
            {bars.map(b => (
              <div class="bar-row">
                <span class="bar-label">{b.label}</span>
                <span class="bar-val">{b.value}</span>
                <span class="bar-track">
                  <span class="bar-fill" style={`width:${(Number(b.value) / peak) * 100}%;background:${b.tone}`}></span>
                </span>
              </div>
            ))}
          </div>
        )}

        {tracker && <a class="vitals-link" href={`/post/${tracker.id}`}>Open the full tracker →</a>}
      </aside>

      {lead && (
        <article class={`lead s-${(lead.data.severity ?? 'none').toLowerCase()}`}>
          <span class="panel-label">Lead briefing</span>
          <div class="lead-meta">
            {lead.data.severity
              ? <SeverityBadge severity={lead.data.severity} />
              : (lead.data.category !== 'ai-healthcare' && <span class="lead-kind">Analysis</span>)}
            <CategoryBadge category={lead.data.category} />
            <time datetime={lead.data.date.toISOString()}>{leadDate}</time>
          </div>
          <h1><a href={`/post/${lead.id}`}>{lead.data.title}</a></h1>
          <p class="lead-excerpt">{lead.data.excerpt}</p>
          <a href={`/post/${lead.id}`} class="lead-more">Open intelligence brief <span>→</span></a>
        </article>
      )}
    </div>
  </section>

  <!-- ── Triage board ─────────────────────────────────────────────── -->
  <section class="container board">
    <div class="eyebrow eyebrow-row">
      <span>Latest intelligence — triaged for Australian providers</span>
      <a href="/blog" class="see-all">View all →</a>
    </div>
    <div class="cases">
      {latest.map(post => (
        <ArticleCard
          title={post.data.title}
          excerpt={post.data.excerpt}
          date={post.data.date}
          category={post.data.category}
          slug={post.id}
          image={post.data.image}
          author={post.data.author}
          severity={post.data.severity}
        />
      ))}
    </div>
  </section>

  <!-- ── Sections ─────────────────────────────────────────────────── -->
  <section class="container sections">
    <div class="eyebrow">Intelligence desks</div>
    <div class="cat-grid">
      {categories.map(cat => (
        <a href={`/category/${cat.slug}`} class="cat">
          <h4>{cat.label}</h4>
          <p>{cat.blurb}</p>
          <span class="count">{counts[cat.slug]} articles</span>
        </a>
      ))}
    </div>
  </section>

  <div class="container"><NewsletterSignup /></div>

  <div class="container" style="margin-bottom:2rem">
    <AdBanner size="leaderboard" id="ad-bottom" />
  </div>
</BaseLayout>

<style>
/* ── editorial masthead ── */
.masthead {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220px;
  gap: clamp(2rem, 7vw, 7rem);
  align-items: end;
  padding-top: clamp(3.5rem, 8vw, 7rem);
  padding-bottom: clamp(3rem, 6vw, 5rem);
}
.edition {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  margin-bottom: 1.35rem;
  font-family: var(--font-mono);
  font-size: 0.67rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
}
.edition::before { content: ''; width: 28px; height: 1px; background: var(--accent); }
.edition span { color: var(--muted); }
.masthead h1 {
  max-width: 850px;
  font-size: clamp(2.7rem, 6.7vw, 6rem);
  line-height: 0.97;
  letter-spacing: -0.055em;
  font-weight: 500;
}
.masthead-intro { max-width: 690px; margin-top: 1.7rem; font-size: clamp(1rem, 1.6vw, 1.2rem); color: var(--subtle); line-height: 1.65; }
.masthead-note { border-left: 1px solid var(--border); padding-left: 1.5rem; display: flex; flex-direction: column; align-items: flex-start; }
.signal { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.signal i { display: inline-block; width: 7px; height: 7px; margin-right: 0.45rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 12%, transparent); }
.masthead-note strong { margin-top: 1.6rem; font-family: var(--font-display); font-size: 3.8rem; line-height: 0.9; font-weight: 500; }
.masthead-note small { margin-top: 0.45rem; color: var(--muted); }
.masthead-note a { margin-top: 1.6rem; font-size: 0.78rem; font-weight: 700; }
@media (max-width: 760px) {
  .masthead { grid-template-columns: 1fr; }
  .masthead-note { display: none; }
  .edition { align-items: flex-start; flex-wrap: wrap; }
  .edition span { width: 100%; margin-left: 2.4rem; }
}

/* ── shared ── */
.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}
.eyebrow::after { content: ''; flex: 1; height: 1px; background: var(--border); }
.eyebrow-row { justify-content: space-between; }
.eyebrow-row::after { order: 1; }
.see-all {
  order: 2;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  color: var(--accent);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: none;
  white-space: nowrap;
}

.hero { margin-top: 0; }
.hero-grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
@media (min-width: 980px) { .hero-grid { grid-template-columns: 380px 1fr; } }

/* ── vitals panel ── */
.vitals {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: clamp(1.5rem, 3vw, 2rem);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.panel-label { font-family: var(--font-mono); font-size: 0.61rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.vitals h2 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  line-height: 1.25;
  font-weight: 700;
  text-wrap: balance;
}
.figure {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: 4.1rem;
  line-height: 1;
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--text);
}
.figure span { font-size: 0.95rem; color: var(--muted); margin-left: 0.5rem; letter-spacing: 0; }
.period { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }

.bars { display: flex; flex-direction: column; gap: 0.6rem; }
.bar-row { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem 0.75rem; align-items: center; }
.bar-label { font-size: 0.78rem; color: var(--subtle); }
.bar-val {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}
.bar-track { grid-column: 1 / -1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
.bar-fill { display: block; height: 100%; border-radius: 2px; }
.vitals-link { font-size: 0.82rem; color: var(--accent); font-weight: 600; }
.vitals-link:hover { color: var(--text); }

/* ── lead story ── */
.lead {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 4px solid var(--border);
  border-radius: 18px;
  padding: clamp(1.7rem, 4vw, 3.2rem);
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}
.lead.s-critical { border-left-color: var(--crit); }
.lead.s-high     { border-left-color: var(--high); }
.lead.s-medium   { border-left-color: var(--med); }
.lead.s-low      { border-left-color: var(--low); }

.lead-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem 0.9rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--muted);
}
.lead-kind {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
}
.lead h1 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.5rem);
  line-height: 1.04;
  letter-spacing: -0.02em;
  font-weight: 700;
  text-wrap: balance;
}
.lead h1 a { color: var(--text); }
.lead h1 a:hover { color: var(--accent); }
.lead-excerpt { color: var(--subtle); max-width: 62ch; line-height: 1.6; }
.lead-more { align-self: flex-start; margin-top: 0.6rem; font-size: 0.82rem; color: var(--accent); font-weight: 700; padding-bottom: 0.35rem; border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
.lead-more span { margin-left: 0.65rem; }
.lead-more:hover { color: var(--text); }

/* ── board ── */
.board { margin-top: 4.5rem; }

/* ── sections ── */
.sections { margin-top: 4.5rem; }
.cat-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
@media (min-width: 760px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
.cat {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  transition: border-color 0.15s, transform 0.15s, background 0.15s;
}
.cat:hover { border-color: var(--accent); transform: translateY(-3px); background: var(--card); }
.cat h4 { font-family: var(--font-display); font-size: 1.55rem; font-weight: 600; color: var(--text); }
.cat p { font-size: 0.85rem; color: var(--subtle); flex: 1; }
.cat .count {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.05em;
}
</style>
