---
const navLinks = [
  { href: '/blog', label: 'Intelligence' },
  { href: '/category/attacks-breaches', label: 'Attacks & Breaches' },
  { href: '/category/ai-healthcare', label: 'AI & Health' },
  { href: '/category/health-it-security', label: 'Health IT' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true"><span></span></span>
      <span class="logo-text">SunTech<span class="logo-accent">Land</span><small>Health intelligence</small></span>
      <span class="locale">AU</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'nav-link active' : 'nav-link'}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href="/post/australia-healthcare-data-breaches-tracker" class="cta-btn">NDB Tracker</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    {navLinks.map(({ href, label }) => (
      <a href={href} class="mobile-nav-link">{label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.getElementById('menuToggle');
  const nav = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    btn?.classList.toggle('open');
    btn?.setAttribute('aria-expanded', String(nav?.classList.contains('open') ?? false));
  });
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: color-mix(in srgb, var(--bg) 84%, transparent);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  min-height: 76px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  text-decoration: none;
  flex-shrink: 0;
}
.logo-mark {
  width: 34px;
  height: 34px;
  border: 1px solid var(--accent);
  border-radius: 50%;
  display: grid;
  place-items: center;
  box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--accent) 8%, transparent);
}
.logo-mark::before, .logo-mark::after, .logo-mark span { content: ''; display: block; position: absolute; background: var(--accent); border-radius: 2px; }
.logo-mark::before { width: 16px; height: 3px; }
.logo-mark::after { width: 3px; height: 16px; }
.logo-mark span { width: 5px; height: 5px; }
.logo-text {
  font-family: var(--font-display);
  font-size: 1.28rem;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.02em;
}
.logo-text small { display: block; margin-top: 0.08rem; font-family: var(--font-mono); font-size: 0.48rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.logo-accent { color: var(--accent); }
.locale {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  color: var(--muted);
  text-transform: uppercase;
  border: 1px solid var(--border);
  padding: 0.1rem 0.35rem;
  border-radius: 2px;
  margin-left: 0.15rem;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  flex: 1;
}
.nav-link {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--subtle);
  padding: 0.4rem 0.75rem;
  border-radius: 6px;
  transition: color 0.15s, background 0.15s;
  white-space: nowrap;
}
.nav-link:hover { color: var(--text); background: var(--surface); }
.nav-link.active { color: var(--accent); }
.nav-link.active::after { content: ''; display: block; width: 18px; height: 1px; margin: 0.28rem auto -0.28rem; background: var(--accent); }

.header-actions { display: flex; align-items: center; gap: 1rem; }
.cta-btn {
  font-size: 0.82rem;
  font-weight: 700;
  color: #06110e;
  background: var(--accent);
  padding: 0.55rem 1rem;
  border-radius: 999px;
  white-space: nowrap;
  transition: opacity 0.2s;
}
.cta-btn:hover { opacity: 0.85; color: #000; }

.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.menu-toggle span {
  display: block; width: 22px; height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
}
.menu-toggle.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.menu-toggle.open span:nth-child(2) { opacity: 0; }
.menu-toggle.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

.mobile-nav {
  display: none;
  flex-direction: column;
  padding: 0.75rem 1.25rem 1rem;
  border-top: 1px solid var(--border);
  background: var(--bg);
}
.mobile-nav.open { display: flex; }
.mobile-nav-link {
  padding: 0.65rem 0;
  font-size: 0.95rem;
  color: var(--subtle);
  border-bottom: 1px solid var(--border);
}
.mobile-nav-link:last-child { border-bottom: none; }
.mobile-nav-link:hover { color: var(--accent); }

@media (max-width: 900px) {
  .main-nav { display: none; }
  .menu-toggle { display: flex; }
}
@media (max-width: 480px) {
  .cta-btn { display: none; }
}
</style>
