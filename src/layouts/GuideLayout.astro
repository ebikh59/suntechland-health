---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated: string;
  updatedIso: string;
  readingTime: string;
  sources: { label: string; href: string }[];
}

const { title, description, eyebrow, updated, updatedIso, readingTime, sources } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updatedIso,
  author: { '@type': 'Organization', name: 'SunTechLand' },
  publisher: { '@type': 'Organization', name: 'SunTechLand' },
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="guide container">
    <header class="guide-header">
      <a href="/resources" class="back">← Practical resources</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="meta"><span>Reviewed {updated}</span><span>{readingTime}</span><span>Australian guidance</span></div>
    </header>
    <div class="guide-grid">
      <div class="guide-content prose"><slot /></div>
      <aside class="guide-aside">
        <div class="source-card">
          <strong>Primary sources</strong>
          <p>Check the latest official requirements before making operational or legal decisions.</p>
          <ul>{sources.map(source => <li><a href={source.href} target="_blank" rel="noopener">{source.label} ↗</a></li>)}</ul>
        </div>
        <a class="digest-card" href="/rss.xml"><span>Weekly reading list</span><strong>Follow the intelligence feed</strong><small>Free RSS feed →</small></a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
.guide { padding: 4rem 1.25rem; max-width: 1120px; }
.guide-header { max-width: 820px; padding-bottom: 2.2rem; border-bottom: 1px solid var(--border); }
.back { display: inline-block; margin-bottom: 2.2rem; color: var(--muted); font-size: .82rem; }
.eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; }
h1 { margin-top: .65rem; font-size: clamp(2.35rem, 6vw, 4.6rem); line-height: 1.02; letter-spacing: -.035em; text-wrap: balance; }
.dek { max-width: 64ch; margin-top: 1.2rem; color: var(--subtle); font-size: 1.1rem; line-height: 1.65; }
.meta { display: flex; flex-wrap: wrap; gap: .55rem 1.25rem; margin-top: 1.35rem; color: var(--muted); font-family: var(--font-mono); font-size: .67rem; text-transform: uppercase; letter-spacing: .06em; }
.guide-grid { display: grid; grid-template-columns: minmax(0, 720px) 280px; gap: 4rem; margin-top: 3rem; align-items: start; }
.guide-content :global(h2) { margin: 2.6rem 0 .8rem; font-size: 1.65rem; }
.guide-content :global(h2:first-child) { margin-top: 0; }
.guide-content :global(h3) { margin: 1.7rem 0 .55rem; font-size: 1.1rem; color: var(--accent); }
.guide-content :global(p), .guide-content :global(li) { color: var(--subtle); line-height: 1.78; }
.guide-content :global(ul), .guide-content :global(ol) { margin: .8rem 0 1.2rem 1.25rem; }
.guide-content :global(li) { margin: .42rem 0; }
.guide-content :global(.callout) { margin: 1.6rem 0; padding: 1rem 1.2rem; border-left: 3px solid var(--accent); background: var(--surface); border-radius: 0 8px 8px 0; }
.guide-aside { position: sticky; top: 100px; display: grid; gap: 1rem; }
.source-card, .digest-card { padding: 1.15rem; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
.source-card strong { color: var(--accent); }
.source-card p { margin: .55rem 0 .8rem; color: var(--muted); font-size: .78rem; line-height: 1.5; }
.source-card ul { list-style: none; display: grid; gap: .55rem; }
.source-card a { font-size: .78rem; color: var(--subtle); }
.digest-card { display: grid; gap: .35rem; }
.digest-card span, .digest-card small { color: var(--accent); font-family: var(--font-mono); font-size: .63rem; text-transform: uppercase; letter-spacing: .08em; }
.digest-card strong { color: var(--text); line-height: 1.3; }
@media (max-width: 860px) { .guide-grid { grid-template-columns: 1fr; gap: 2rem; } .guide-aside { position: static; } }
@media (max-width: 520px) { .guide { padding-top: 2rem; } .back { margin-bottom: 1.5rem; } }
</style>
